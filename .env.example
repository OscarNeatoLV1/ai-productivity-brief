# Copy this file to ".env" and fill in your values.

# Required to generate the written brief.
# Get an API key at: https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Optional: a JSON endpoint of saved productivity sessions (e.g. a Firebase
# Realtime DB ".json" URL). If left blank, the app runs in demo mode against
# the bundled sample-archive.json.
ARCHIVE_URL=

# Optional: a Slack Incoming Webhook URL to auto-post the brief.
SLACK_WEBHOOK_URL=
