# Copy this file to ".env" and fill in your values.

# Required to generate the written brief.
# Get an API key at: https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Optional: the base path of your sealed-shift archive (a Firebase Realtime DB
# node, WITHOUT the trailing ".json"). Each child is one day, keyed YYYY-MM-DD.
# Leave blank to use the built-in default. Set BRIEF_DEMO=1 to run offline
# against the bundled sample-archive.json.
FLOW_HISTORY_URL=

# Optional: DM the brief to yourself on Slack.
# SLACK_BOT_TOKEN = a Slack app's Bot User OAuth Token (starts with xoxb-).
# SLACK_DM_TO     = your Slack user ID (looks like U0XXXXXXX).
SLACK_BOT_TOKEN=
SLACK_DM_TO=
